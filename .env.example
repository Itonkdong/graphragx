OPENAI_API_KEY=
DEEPSEEK_API_KEY=
VEZILKA_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GRAPHRAGX_LOG_LEVEL=INFO
GRAPHRAGX_LOG_COLOR=cyan

# Qdrant must be running for embedding storage. Start it with `docker compose up -d qdrant`.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=graphragx_embeddings

# WandB is enabled by default for full runs. Run `wandb login` or set WANDB_API_KEY, or use --no-wandb.
WANDB_API_KEY=
WANDB_PROJECT=graphragx
WANDB_ENTITY=
WANDB_MODE=online

# Docker Compose writes bind-mounted files as this user. Change these values
# to the output of `id -u` and `id -g` on Linux when your IDs are not 1000.
GRAPHRAGX_UID=1000
GRAPHRAGX_GID=1000
GRAPHRAGX_WAIT_FOR_QDRANT=1
GRAPHRAGX_QDRANT_WAIT_SECONDS=60
